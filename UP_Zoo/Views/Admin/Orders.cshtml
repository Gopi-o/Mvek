@model IReadOnlyList<ShopOrder>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Заказы";
}
<div class="admin-page-heading"><div><span class="eyebrow">ЗАКАЗЫ</span><h1>Заказы покупателей</h1><p>Просмотр заказов и обработка их статусов.</p></div></div>
<section class="admin-panel"><div class="table-responsive"><table class="table admin-table"><thead><tr><th>№</th><th>Покупатель</th><th>Контакты</th><th>Дата</th><th>Сумма</th><th>Статус</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="7" class="text-center text-muted">Заказов пока нет</td></tr>}@foreach(var item in Model){<tr><td>#@item.Id</td><td>@item.CustomerName<small class="d-block text-muted">@(item.UserId is null?"Гостевой заказ":"Аккаунт")</small></td><td>@item.Email<small class="d-block text-muted">@item.Phone</small></td><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td>@item.Total.ToString("N0") ₽</td><td><span class="admin-status">@(OrderStatuses.Labels.GetValueOrDefault(item.Status,item.Status))</span></td><td><a asp-action="Order" asp-route-id="@item.Id">Открыть →</a></td></tr>}</tbody></table></div></section>
