@model IReadOnlyList<ShopOrder>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Обзор";
}
<div class="admin-page-heading"><div><span class="eyebrow">UP_ZOO / ПАНЕЛЬ УПРАВЛЕНИЯ</span><h1>Обзор магазина</h1><p>Добро пожаловать! Здесь собраны основные показатели магазина.</p></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="admin-stat"><span>Товары</span><strong>@ViewBag.ProductCount</strong><small>позиций в каталоге</small></div></div><div class="col-6 col-xl-3"><div class="admin-stat"><span>Заказы</span><strong>@ViewBag.OrderCount</strong><small>всего заказов</small></div></div><div class="col-6 col-xl-3"><div class="admin-stat"><span>Новые заказы</span><strong>@ViewBag.NewOrderCount</strong><small>требуют внимания</small></div></div><div class="col-6 col-xl-3"><div class="admin-stat"><span>Отзывы</span><strong>@ViewBag.PendingReviewCount</strong><small>ожидают модерации</small></div></div></div>
<div class="row g-4"><div class="col-lg-8"><section class="admin-panel"><div class="admin-panel-heading"><h2>Последние заказы</h2><a asp-action="Orders">Все заказы →</a></div><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Заказ</th><th>Покупатель</th><th>Дата</th><th>Сумма</th><th>Статус</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">Заказов пока нет</td></tr>}@foreach(var order in Model){<tr><td><a asp-action="Order" asp-route-id="@order.Id">#@order.Id</a></td><td>@order.CustomerName</td><td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td><td>@order.Total.ToString("N0") ₽</td><td><span class="admin-status">@(OrderStatuses.Labels.GetValueOrDefault(order.Status, order.Status))</span></td></tr>}</tbody></table></div></section></div><div class="col-lg-4"><section class="admin-panel admin-review-alert"><span class="eyebrow">ОТЗЫВЫ</span><strong>@ViewBag.PendingReviewCount</strong><p>отзывов ожидают модерации</p><a class="btn btn-primary-soft" asp-action="Reviews">Перейти к отзывам →</a></section></div></div>
