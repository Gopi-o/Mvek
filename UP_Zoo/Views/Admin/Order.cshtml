@model ShopOrder
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Заказ №{Model.Id}";
}
<div class="admin-page-heading"><div><span class="eyebrow">ЗАКАЗЫ / #@Model.Id</span><h1>Заказ №@Model.Id</h1><p>Создан @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @(Model.UserId is null?"Гостевой заказ":"Заказ аккаунта")</p></div><a class="btn btn-outline-purple" asp-action="Orders">← Все заказы</a></div>
<div class="row g-4"><div class="col-lg-7"><section class="admin-panel"><h2 class="admin-section-title">Состав заказа</h2><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Товар</th><th>Цена</th><th>Кол-во</th><th>Итого</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.ProductName</td><td>@item.Price.ToString("N0") ₽</td><td>@item.Quantity</td><td>@((item.Price*item.Quantity).ToString("N0")) ₽</td></tr>}</tbody><tfoot><tr><th colspan="3">Сумма заказа</th><th>@Model.Total.ToString("N0") ₽</th></tr></tfoot></table></div></section></div><div class="col-lg-5"><section class="admin-panel mb-4"><h2 class="admin-section-title">Данные доставки</h2><dl class="admin-details"><dt>Получатель</dt><dd>@Model.CustomerName</dd><dt>Телефон</dt><dd>@Model.Phone</dd><dt>Почта</dt><dd>@Model.Email</dd><dt>Адрес</dt><dd>@Model.Address</dd><dt>Комментарий</dt><dd>@(Model.Notes??"—")</dd></dl></section><section class="admin-panel"><h2 class="admin-section-title">Статус заказа</h2><form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post"><select class="form-select mb-3" name="status">@foreach(var status in OrderStatuses.Labels){<option value="@status.Key" selected="@(Model.Status==status.Key)">@status.Value</option>}</select><button class="btn btn-primary-soft">Сохранить статус</button></form></section></div></div>
