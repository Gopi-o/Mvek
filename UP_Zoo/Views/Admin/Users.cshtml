@model IReadOnlyList<AppUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Пользователи";
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? [];
    var userRoles = ViewBag.UserRoles as IReadOnlyDictionary<string, string> ?? new Dictionary<string, string>();
}
<div class="admin-page-heading"><div><span class="eyebrow">ПОЛЬЗОВАТЕЛИ</span><h1>Пользователи и роли</h1><p>Назначайте роли покупателя, менеджера и администратора.</p></div></div>
<section class="admin-panel"><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Пользователь</th><th>Почта</th><th>Дата регистрации</th><th>Роль</th><th>Действие</th></tr></thead><tbody>@foreach(var user in Model){<tr><td><strong>@user.DisplayName</strong>@if(user.Id==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value){<small class="d-block text-muted">Это вы</small>}</td><td>@user.Email</td><td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td><td><form class="d-flex gap-2" asp-action="UpdateRole" asp-route-id="@user.Id" method="post"><select class="form-select form-select-sm" name="role">@foreach(var role in roles){<option value="@role" selected="@(userRoles.GetValueOrDefault(user.Id)==role)">@role</option>}</select><button class="btn btn-sm btn-outline-purple">Сохранить</button></form></td><td>@if(user.Id!=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value){<form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Удалить пользователя?')"><button class="admin-danger-link">Удалить</button></form>}</td></tr>}</tbody></table></div></section>
