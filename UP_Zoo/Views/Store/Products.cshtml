@model CatalogViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="page-hero"><div class="container"><span class="eyebrow">ПОДБРАНО С ЗАБОТОЙ</span><h1>@Model.Title</h1><p>Свежие находки и приятные цены для ваших питомцев.</p></div></section>
<section class="section-block"><div class="container">@if(Model.Products.Count == 0){<div class="empty-state"><span>🐾</span><h2>Скоро здесь появятся товары</h2></div>}else{<div class="row g-4">@foreach(var product in Model.Products){<div class="col-6 col-lg-3"><partial name="_ProductCard" model="product" /></div>}</div>}</div></section>
