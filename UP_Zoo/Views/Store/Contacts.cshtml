@model ContactMessage
@{
    ViewData["Title"] = "Контакты";
}
<section class="page-hero"><div class="container"><span class="eyebrow">МЫ РЯДОМ</span><h1>Контакты</h1><p>Подскажем, поможем и вместе найдём лучшее для вашего питомца.</p></div></section>
<section class="section-block"><div class="container"><div class="row g-5"><div class="col-lg-5"><span class="eyebrow">НА СВЯЗИ КАЖДЫЙ ДЕНЬ</span><h2 class="content-heading">Будем рады знакомству</h2><div class="contact-list"><div><span>Телефон</span><a href="tel:+78005553535">8 800 555-35-35</a></div><div><span>Почта</span><a href="mailto:hello@upzoo.ru">hello@upzoo.ru</a></div><div><span>Время работы</span><strong>Ежедневно, 9:00–21:00</strong></div><div><span>Адрес</span><strong>Москва, ул. Добрых лап, 12</strong></div></div><div class="map-placeholder">🐾<span>Здесь будет карта проезда</span></div></div>
<div class="col-lg-7"><div class="form-card"><h2>Напишите нам</h2><p>Ответим на сообщение в ближайшее рабочее время.</p><div asp-validation-summary="All" class="text-danger"></div><form asp-action="Contacts" method="post" class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label">Ваше имя</label><input asp-for="Name" class="form-control"></div><div class="col-md-6"><label asp-for="Email" class="form-label">Электронная почта</label><input asp-for="Email" class="form-control"></div><div class="col-12"><label asp-for="Subject" class="form-label">Тема</label><input asp-for="Subject" class="form-control"></div><div class="col-12"><label asp-for="Message" class="form-label">Сообщение</label><textarea asp-for="Message" class="form-control" rows="5"></textarea></div><div class="col-12"><button class="btn btn-primary-soft">Отправить сообщение →</button></div></form></div></div></div></div></section>
