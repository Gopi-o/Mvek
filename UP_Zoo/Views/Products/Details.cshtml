@model Product
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.Related as IReadOnlyList<Product> ?? [];
}
<section class="section-block"><div class="container"><div class="row g-5 align-items-center">
    <div class="col-lg-6"><div class="product-detail-visual">@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img src="@Model.ImageUrl" alt="@Model.Name">}else{<span>@(Model.Category?.Icon ?? "🐾")</span>}</div></div>
    <div class="col-lg-6"><div class="product-meta">@(Model.Brand?.Name ?? "UP_ZOO") · @(Model.Category?.Name ?? "Для питомцев")</div><h1 class="content-heading">@Model.Name</h1><p class="content-copy">@Model.Description</p><div class="detail-price">@Model.CurrentPrice.ToString("N0") ₽ @if(Model.SalePrice.HasValue){<del>@Model.Price.ToString("N0") ₽</del>}</div><p class="text-muted">@(Model.Stock > 0 ? "Есть в наличии" : "Нет в наличии")</p>
        @if(Model.Stock > 0){<form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 mt-4"><input type="hidden" name="id" value="@Model.Id"><label class="visually-hidden" for="quantity">Количество</label><input class="form-control quantity-input" id="quantity" type="number" name="quantity" min="1" max="@Math.Min(Model.Stock, 99)" value="1"><button class="btn btn-primary-soft">Добавить в корзину →</button></form>}
    </div>
</div>
@if(related.Count > 0){<div class="section-heading mt-5"><h2>Вам может понравиться</h2></div><div class="row g-4">@foreach(var product in related){<div class="col-6 col-lg-3"><partial name="_ProductCard" model="product" /></div>}</div>}
</div></section>
