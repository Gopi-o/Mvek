@using UP_Zoo.Models
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — панель UP_ZOO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="admin-body">
    <header class="admin-topbar"><div class="container-fluid d-flex align-items-center justify-content-between gap-3"><a class="brand-mark" asp-controller="Admin" asp-action="Index"><span class="brand-paw">✿</span> UP_<span>ZOO</span> <small>ПАНЕЛЬ УПРАВЛЕНИЯ</small></a><div class="d-flex align-items-center gap-3"><span class="admin-user">@User.Identity?.Name</span><a class="admin-back-link" asp-controller="Home" asp-action="Index">На сайт ↗</a></div></div></header>
    <div class="admin-shell"><aside class="admin-sidebar"><span class="admin-nav-label">УПРАВЛЕНИЕ</span><a asp-controller="Admin" asp-action="Index">Обзор</a>
        @if(User.IsInRole(ShopRoles.Admin)){<a asp-controller="Admin" asp-action="Products">Товары</a><a asp-controller="Admin" asp-action="Categories">Категории</a><a asp-controller="Admin" asp-action="Brands">Бренды</a>}
        <a asp-controller="Admin" asp-action="Orders">Заказы</a><a asp-controller="Admin" asp-action="Reviews">Отзывы</a>
        @if(User.IsInRole(ShopRoles.Admin)){<a asp-controller="Admin" asp-action="Users">Пользователи</a>}
        <div class="admin-sidebar-bottom"><a asp-controller="Account" asp-action="Index">Личный кабинет</a><form asp-controller="Account" asp-action="Logout" method="post"><button>Выйти</button></form></div>
    </aside><main class="admin-content">
        @if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
        @if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
        @RenderBody()
    </main></div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
