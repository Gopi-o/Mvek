@using UP_Zoo.Models
@using UP_Zoo.Services
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#7c1ca6">
    <title>@ViewData["Title"] — UP_ZOO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div class="topline">Бережная доставка для хвостиков — от 2 000 ₽ бесплатно</div>
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top border-bottom">
        <div class="container">
            <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index"><span class="brand-paw">✿</span> UP_<span>ZOO</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Открыть меню"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav mx-auto">
                    <a class="nav-link" asp-controller="Store" asp-action="About">О магазине</a>
                    <a class="nav-link" asp-controller="Products" asp-action="Index">Каталог</a>
                    <a class="nav-link" asp-controller="Store" asp-action="Promotions">Акции</a>
                    <a class="nav-link" asp-controller="Store" asp-action="New">Новинки</a>
                    <a class="nav-link" asp-controller="Store" asp-action="Brands">Бренды</a>
                    <a class="nav-link" asp-controller="Store" asp-action="Reviews">Отзывы</a>
                    <a class="nav-link" asp-controller="Store" asp-action="Contacts">Контакты</a>
                </div>
                <div class="nav-actions">
                    <a class="nav-icon-link" asp-controller="Cart" asp-action="Index">Корзина <span class="cart-count">@CartSession.GetQuantities(Context.Session).Values.Sum()</span></a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-icon-link" asp-controller="Account" asp-action="Index">Кабинет</a>
                        @if (User.IsInRole(ShopRoles.Admin) || User.IsInRole(ShopRoles.Manager))
                        {
                            <a class="nav-icon-link" asp-controller="Admin" asp-action="Index">Панель</a>
                        }
                    }
                    else
                    {
                        <a class="nav-icon-link" asp-controller="Account" asp-action="Login">Войти</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    @if (TempData["Success"] is string success)
    {
        <div class="container pt-3"><div class="alert alert-success">@success</div></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="container pt-3"><div class="alert alert-danger">@error</div></div>
    }
    <main>@RenderBody()</main>
    <footer class="site-footer">
        <div class="container"><div class="row g-4 py-5">
            <div class="col-lg-4"><a class="navbar-brand brand-mark text-white" asp-controller="Home" asp-action="Index"><span class="brand-paw">✿</span> UP_<span>ZOO</span></a><p class="footer-copy mt-3">Маленькие радости для тех, кто делает наш дом теплее.</p></div>
            <div class="col-6 col-lg-2"><h2 class="footer-heading">Магазин</h2><a asp-controller="Store" asp-action="About">О нас</a><a asp-controller="Products" asp-action="Index">Каталог</a><a asp-controller="Store" asp-action="Promotions">Акции</a></div>
            <div class="col-6 col-lg-2"><h2 class="footer-heading">Покупателям</h2><a asp-controller="Store" asp-action="Reviews">Отзывы</a><a asp-controller="Store" asp-action="Contacts">Контакты</a><a asp-controller="Cart" asp-action="Index">Корзина</a></div>
            <div class="col-lg-4"><h2 class="footer-heading">Всегда на связи</h2><a href="tel:+78005553535">8 800 555-35-35</a><a href="mailto:hello@upzoo.ru">hello@upzoo.ru</a><p class="footer-copy mt-2">Ежедневно, 9:00–21:00</p></div>
        </div><div class="footer-bottom d-flex flex-column flex-md-row justify-content-between gap-2"><span>© @DateTime.Now.Year UP_ZOO. Забота в каждом хвостике.</span><span>Цены указаны в рублях. Информация на сайте носит ознакомительный характер.</span></div></div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
