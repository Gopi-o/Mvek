@model RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}
<section class="auth-section"><div class="auth-card"><span class="auth-icon">🐾</span><span class="eyebrow">ДОБРО ПОЖАЛОВАТЬ</span><h1>Создать аккаунт</h1><p>Чтобы хорошие покупки и заказы всегда были под рукой.</p><div asp-validation-summary="All" class="text-danger text-start"></div><form asp-action="Register" method="post" class="row g-3 text-start">
    <div class="col-12"><label asp-for="DisplayName" class="form-label">Ваше имя</label><input asp-for="DisplayName" class="form-control" autocomplete="name"></div>
    <div class="col-12"><label asp-for="Email" class="form-label">Электронная почта</label><input asp-for="Email" class="form-control" autocomplete="email"></div>
    <div class="col-12"><label asp-for="Password" class="form-label">Пароль</label><input asp-for="Password" class="form-control" autocomplete="new-password"><div class="form-text">Не менее 8 символов: заглавная и строчная буквы, цифра и специальный символ.</div></div>
    <div class="col-12"><label asp-for="ConfirmPassword" class="form-label">Повторите пароль</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"></div>
    <div class="col-12"><button class="btn btn-primary-soft w-100">Зарегистрироваться →</button></div>
</form><div class="auth-bottom">Уже есть аккаунт? <a asp-action="Login">Войти</a></div></div></section>
