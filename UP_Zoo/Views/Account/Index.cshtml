@model IReadOnlyList<ShopOrder>
@{
    ViewData["Title"] = "Личный кабинет";
    var statusLabels = OrderStatuses.Labels;
}
<section class="page-hero"><div class="container"><span class="eyebrow">РАДЫ ВАС ВИДЕТЬ</span><h1>Личный кабинет</h1><p>Здравствуйте, @User.Identity?.Name!</p></div></section>
<section class="section-block"><div class="container"><div class="row g-5"><div class="col-lg-4"><div class="form-card"><h2>Мои данные</h2><p>@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>@if(User.IsInRole(ShopRoles.Admin)||User.IsInRole(ShopRoles.Manager)){<a class="btn btn-outline-purple rounded-pill mt-2" asp-controller="Admin" asp-action="Index">Открыть панель управления →</a>}<form asp-action="Logout" method="post" class="mt-3"><button class="btn btn-link text-danger p-0">Выйти из аккаунта</button></form></div></div><div class="col-lg-8"><div class="section-heading"><h2>История заказов</h2><a class="text-link" asp-controller="Products" asp-action="Index">За покупками →</a></div>
@if(Model.Count == 0){<div class="empty-state compact"><span>🧾</span><h3>Заказов пока нет</h3><p>После оформления заказа он появится здесь.</p><a class="btn btn-outline-purple rounded-pill" asp-controller="Products" asp-action="Index">Открыть каталог</a></div>}
@foreach(var order in Model){<article class="account-order"><div class="d-flex justify-content-between flex-wrap gap-2"><strong>Заказ №@order.Id</strong><span class="order-status">@(statusLabels.GetValueOrDefault(order.Status, order.Status))</span></div><small>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small><div class="order-items-list">@foreach(var item in order.Items){<span>@item.ProductName × @item.Quantity</span>}</div><strong class="d-block mt-2">@order.Total.ToString("N0") ₽</strong></article>}
</div></div></div></section>
